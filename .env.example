# ============================================================
#  HISTORIA CLÍNICA VEHICULAR · API — variables de entorno
#  Copiá este archivo como `.env` y ajustá si hace falta:
#      copy .env.example .env      (Windows)
#      cp .env.example .env        (Linux/macOS)
# ============================================================

# Puerto HTTP de la API
PORT=3000

# Origen permitido para CORS. Con `*` cualquier página web puede leer la API
# de tu taller (dev local). Antes de subir a producción cambialo por la lista
# de orígenes del frontend, separados por coma, y arrancá NODE_ENV=production
# (el server RECHAZA arrancar con * en producción — fail-closed):
#   CORS_ORIGIN=https://taller.midominio.com,http://192.168.1.10:8800
CORS_ORIGIN=*

# Driver de base de datos: sqlite (default, archivo local, 0 configuración)
# El esquema de db/schema.sql es también compatible con PostgreSQL 12+;
# la extensión pg queda prevista en db.js (ver comentario del adapter).
DB_DRIVER=sqlite

# Ruta del archivo SQLite (relativa a la raíz del proyecto)
DB_PATH=./data/taller.sqlite

# --- Sólo si migrás a PostgreSQL (requiere `npm i pg`) ---
# DB_DRIVER=pg
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=taller
# PGUSER=taller_admin
# PGPASSWORD=cambiar_esta_contrasena
