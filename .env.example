# ============================================================
#  HISTORIA CLÍNICA VEHICULAR · API — variables de entorno
#  Copiá este archivo como `.env` y ajustá si hace falta:
#      copy .env.example .env      (Windows)
#      cp .env.example .env        (Linux/macOS)
# ============================================================

# Puerto HTTP de la API
PORT=3000

# Entorno: development por defecto. Sólo el valor EXACTO "development" habilita
# el modo laxo; cualquier otro (vacío, production, staging…) es estricto:
#   · se exige CORS_ORIGIN (no se acepta *) y JWT_SECRET
#   · /health responde sólo {ok} (sin driver ni ruta de la BD)
#   · OTP/tokens NUNCA van en respuestas ni logs (sólo con DEV_EXPOSE_CODES)
NODE_ENV=development

# Origen permitido para CORS. Con `*` cualquier página web puede leer la API
# de tu taller (dev local). Antes de subir a producción cambialo por la lista
# de orígenes del frontend, separados por coma (el server rechaza arrancar
# con * en producción — fail-closed):
#   CORS_ORIGIN=https://taller.midominio.com,http://192.168.1.10:8800
CORS_ORIGIN=*

# ============================================================
#  FASE 1 · SESIONES (teléfono + OTP mock → JWT de 30 días)
#  Generá un secreto fuerte por instalación, por ejemplo con:
#    node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
#  Sin JWT_SECRET el server arranca SOLO con NODE_ENV=development y aun así
#  con una clave aleatoria EFÍMERA (desconocida). Con JWT_SECRET definida se
#  exige un mínimo de fuerza (>= 32 caracteres).
# ============================================================
JWT_SECRET=

# Códigos de prueba (OTP y tokens de reset) para QA: requieren DOS llaves,
# NODE_ENV=development + DEV_EXPOSE_CODES=true. Con ambas, los mocks se
# imprimen por consola y las respuestas llevan dev: {otp|token}. Déjalo
# comentado salvo en tu máquina de desarrollo (jamás en un server real):
# DEV_EXPOSE_CODES=true

# Driver de base de datos: sqlite (default, archivo local, 0 configuración)
# El esquema de schema.sql es también compatible con PostgreSQL 12+;
# la extensión pg queda prevista en db.js (ver comentario del adapter).
DB_DRIVER=sqlite

# Ruta del archivo SQLite (relativa a la raíz del proyecto)
DB_PATH=./data/taller.sqlite

# --- Sólo si migrás a PostgreSQL (requiere `npm i pg`) ---
# DB_DRIVER=pg
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=taller
# PGUSER=taller_admin
# PGPASSWORD=cambiar_esta_contrasena
